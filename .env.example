DATABASE_URL=
ADMIN_PASSWORD=
ADMIN_SECRET=
IP_HASH_SALT=
# NEXT_PUBLIC_UNOFFICIAL=0   # 非公式表示を外す場合のみ（既定は表示）
# NEXT_PUBLIC_SITE_URL=https://evenow.jp   # 独自ドメイン取得後に設定（未設定ならVercelの本番URL）
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=   # Search Console の HTMLタグの content の値
# 掲載停止の申請・問い合わせの通知先（公開リポジトリなのでアドレスはコードに書かず、ここ／Vercelの環境変数で設定）
CONTACT_EMAIL=
# メール送信サービス Resend の API キー（https://resend.com）。未設定でも申請は保存され、管理画面で確認できる
RESEND_API_KEY=
# 送信元（独自ドメインを Resend で認証したら設定。未設定なら onboarding@resend.dev）
# CONTACT_FROM=EVENOW <info@evenow.jp>
# 自動収集（Claude API）。未設定なら取得のみ
ANTHROPIC_API_KEY=
# COLLECT_MODEL=claude-opus-5-5   # 既定は claude-haiku-5-5。精度が足りないときだけ切り替え
# 定期実行の呼び出し用の秘密の文字列（16文字以上）。GitHub Actions の Secrets にも同じ値を登録
CRON_SECRET=
